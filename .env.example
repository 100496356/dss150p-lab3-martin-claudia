# Copy to .env and adjust. Never commit the real .env (it is in .gitignore).
# Host-side commands use localhost; docker compose overrides POSTGRES_HOST=postgres for containers.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dss150p
POSTGRES_USER=dss150p
# Training value: replace it with your own password in .env
POSTGRES_PASSWORD=change_me

# Airflow (Goal 4). Needed on Linux so files written by containers belong to your user: run `id -u`.
AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=apache/airflow:2.10.5-python3.11

# Optional: force a specific run id for manual CLI runs (Airflow sets it automatically).
# PIPELINE_RUN_ID=manual_test_001
