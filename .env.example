# DSS150P Lab 3 — environment variable template
# Copy this file to .env and fill in real values for your machine.
# Never commit the real .env file — it is listed in .gitignore.

# Used for commands run directly on the host (venv, not inside Docker).
# Docker Compose overrides this to the service hostname "postgres" for
# the pipeline container, per docker-compose.yml.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dss150p
POSTGRES_USER=dss150p
POSTGRES_PASSWORD=change_me

# Optional: override the auto-generated pipeline run id (used by
# src/common/audit.py). Leave unset to let the pipeline generate one
# automatically based on the current UTC timestamp.
# PIPELINE_RUN_ID=
